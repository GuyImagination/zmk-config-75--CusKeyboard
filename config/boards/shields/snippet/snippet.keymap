#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC   &kp T    &kp E    &kp F    &kp S     &kp A     &kp W     &kp Q      &kp B     &kp H    &kp K     &kp L     &kp B     &kp GRAVE
                &kp GRAVE &kp N1   &kp N2   &kp N3   &kp N4    &kp N5    &kp N6    &kp N7     &kp N8    &kp N9   &kp N0    &kp MINUS &kp EQUAL &kp T
                &kp N1    &kp Q    &kp W    &kp E    &kp R     &kp T     &kp Y     &kp U      &kp I     &kp O    &kp P     &kp LBKT  &kp RBKT  &kp E
                &kp N2    &kp A    &kp S    &kp D    &kp F     &kp G     &kp H     &kp J      &kp K     &kp L    &kp SEMI  &kp SQT   &kp ENTER &kp P
                &kp N3    &kp Z    &kp X    &kp C    &kp V     &kp B     &kp N     &kp M      &kp COMMA &kp DOT  &kp FSLH  &kp RSHFT &kp P     &kp N8
                &kp N4    &kp N5   &kp N6                      &kp SPACE &kp N7    &kp N8     &kp LEFT  &kp DOWN &kp UP    &kp RIGHT F         &kp N3
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        
    };
};